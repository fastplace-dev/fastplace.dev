{
  "name": "@fastplace/react",
  "version": "0.3.0",
  "description": "React bridge for Fastplace — server-driven SPA over the X-Fastplace-Request protocol",
  "homepage": "https://fastplace.dev",
  "bugs": {
    "url": "https://github.com/fastplace-dev/fastplace.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastplace-dev/fastplace.dev.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/fastplace-react.js",
  "module": "./dist/fastplace-react.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fastplace-react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
