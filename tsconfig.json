{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./resources/js/*"],
      "@fastplace/react": ["./packages/react/src/index.tsx"]
    }
  },
  "include": ["packages/react/src", "packages/ai-react/src", "resources/js"]
}
