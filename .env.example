# Fastplace environment — copy to .env and adjust. Env vars always win over
# the defaults in config/*.py.

APP_NAME=Fastplace
APP_ENV=local
# Flip to true locally for verbose errors; the kernel force-disables debug
# output whenever APP_ENV=production regardless of this flag.
APP_DEBUG=true
APP_URL=http://localhost:8000
# 32+ byte secret: signs sessions, mints JWTs, signs CSRF tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_KEY=

# Server-side sessions (opaque-ID cookie + store, kernel-installed)
SESSION_COOKIE=fastplace_session
SESSION_LIFETIME=7200
# Paths exempt from CSRF checks (comma-separated globs, e.g. /webhook/*)
# CSRF_EXCEPT=

# Bridge + assets (dev)
VITE_DEV_URL=http://localhost:5173
VITE_PORT=5173
# Optional cache-busting suffix on built asset URLs (public/build manifest).
# ASSET_VERSION=

# Auth — which guard `request.user` resolves through (session | token)
AUTH_DEFAULT_GUARD=session
# Login lockout: after this many failed attempts for one email|ip pair the
# next attempt is locked out for AUTH_LOGIN_DECAY seconds.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY=60
# Seconds a password confirmation stays valid (password.confirm alias).
# PASSWORD_TIMEOUT=10800
# Feature flag: two-factor management endpoints + UI (Phase 4).
# TWO_FACTOR_ENABLED=true
# Zero-arg abilities precomputed into every page payload's auth.can (comma-separated).
# AUTH_SHARED_ABILITIES=
# Password policy, server dialect (Phase 2 honors the "min:N" clause)
PASSWORD_RULES=min:8
# Password reset + email verification (Phase 3)
# Minutes a reset token stays live / seconds between reset emails per address
# AUTH_PASSWORD_EXPIRE=60
# AUTH_RESET_THROTTLE=60
# Hosts allowed to name the origin when APP_URL is empty (comma-separated)
# TRUSTED_HOSTS=app.example.test,api.example.test

# Mail — log (default) | memory (tests) | smtp (requires `pip install 'fastplace[mail]'`)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=fastplace@localhost
# Display name for the outbound sender — "Name <address>" (empty = bare address)
MAIL_FROM_NAME=
# SMTP settings (MAIL_DRIVER=smtp) — MAIL_ENCRYPTION: none | tls | starttls
# MAIL_HOST=127.0.0.1
# MAIL_PORT=25
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=none

# Database (default: zero-config SQLite)
# DATABASE_DRIVER=sqlite
# DATABASE_URL=sqlite+aiosqlite:///./database.sqlite3
# Pool tuning (server backends only — sqlite uses one serialized connection)
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_ECHO=false
# Read replicas (JSON array or comma-separated) — standalone reads round-robin
# across them; any write pins the rest of the request to the primary
# (read-after-write consistency).
# DATABASE_READ_REPLICAS=["postgresql://host/replica1", "postgresql://host/replica2"]

# Query instrumentation (every engine)
# Statements slower than QUERY_SLOW_MS warn; a statement repeating
# QUERY_N1_THRESHOLD times in one request flags the N+1 pattern.
# QUERY_SLOW_MS=250
# QUERY_N1_THRESHOLD=5

# MongoDB (document adapter — fastplace.orm.documents.Document)
# MONGODB_URL=mongodb://localhost:27017/appdb
# MONGODB_DATABASE=appdb  # only needed when the URL names no database

# Cache — memory (dev default) | redis | database
CACHE_DRIVER=memory
CACHE_TTL=3600
# Redis keys are namespaced (the DB is shared with the queue) — flush() clears only this prefix
CACHE_PREFIX=fastplace:cache:
REDIS_URL=redis://localhost:6379/0

# Queue — memory (default dev driver) or saq (production, redis-backed)
QUEUE_DRIVER=memory
QUEUE_NAME=fastplace
QUEUE_REDIS_URL=redis://localhost:6379/0

# AI — LiteLLM model strings; API keys come from the environment
# (OPENAI_API_KEY / ANTHROPIC_API_KEY), never from this file.
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_ROUNDS=8
AI_VECTOR_STORE=pgvector
