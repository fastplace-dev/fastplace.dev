# Fastplace environment — copy to .env and adjust. Env vars always win over
# the defaults in config/*.py.

APP_NAME=Fastplace
APP_ENV=local
# Flip to true locally for verbose errors; the kernel force-disables debug
# output whenever APP_ENV=production regardless of this flag.
APP_DEBUG=true
APP_URL=http://localhost:9000
# Bind interface: `run dev` defaults to 127.0.0.1 (loopback only); `serve`
# defaults to 0.0.0.0 (every interface, for reverse-proxy deploys).
# APP_HOST=127.0.0.1
# Bind port. Unset = 9000, and `run dev` auto-falls back to the next free
# port; setting APP_PORT (or --port) pins it strictly instead.
# APP_PORT=9000
# 32+ byte secret: signs sessions, mints JWTs, signs CSRF tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_KEY=

# Server-side sessions (opaque-ID cookie + store, kernel-installed)
SESSION_COOKIE=fastplace_session
SESSION_LIFETIME=7200
# Paths exempt from CSRF checks (comma-separated globs, e.g. /webhook/*)
# CSRF_EXCEPT=

# Bridge + assets (dev)
VITE_DEV_URL=http://localhost:5173
VITE_PORT=5173
# Optional cache-busting suffix on built asset URLs (public/build manifest).
# ASSET_VERSION=

# Prerender (SSG) — comma-separated routes captured by `fastplace prerender`
# (e.g. /, /docs). Precedence: --route flags, then the PRERENDER_ROUTES list
# in asgi.py, then this variable, then "/" by default. To disable
# prerendering entirely, set PRERENDER_ROUTES = [] in asgi.py (an empty or
# unset variable here does NOT disable it — that falls back to "/").
#PRERENDER_ROUTES=/

# Auth — which guard `request.user` resolves through (session | token)
AUTH_DEFAULT_GUARD=session
# Login lockout: after this many failed attempts for one email|ip pair the
# next attempt is locked out for AUTH_LOGIN_DECAY seconds.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY=60
# Register throttle headroom (POST /register allows this many per minute per
# IP). Default 5; dense test topologies (e2e) raise it — production does not.
# AUTH_REGISTER_THROTTLE_MAX=5
# Seconds a password confirmation stays valid (password.confirm alias).
# PASSWORD_TIMEOUT=10800
# Feature flag: two-factor management endpoints + UI (Phase 4).
# TWO_FACTOR_ENABLED=true
# Zero-arg abilities precomputed into every page payload's auth.can (comma-separated).
# AUTH_SHARED_ABILITIES=
# Password policy, server dialect (Phase 2 honors the "min:N" clause)
PASSWORD_RULES=min:8
# Password reset + email verification (Phase 3)
# Minutes a reset token stays live / seconds between reset emails per address
# AUTH_PASSWORD_EXPIRE=60
# AUTH_RESET_THROTTLE=60
# Hosts allowed to name the origin when APP_URL is empty (comma-separated)
# TRUSTED_HOSTS=app.example.test,api.example.test

# Passkeys (WebAuthn) — needs the 'webauthn' extra: pip install 'fastplace[webauthn]'
# APP_PASSKEYS_ENABLED=true
# APP_PASSKEYS_RP_ID=
# APP_PASSKEYS_RP_NAME=
# APP_PASSKEYS_ORIGINS=
# APP_PASSKEYS_USER_VERIFICATION=preferred
# APP_PASSKEYS_ATTESTATION=none
# APP_PASSKEYS_TIMEOUT_MS=60000
# APP_PASSKEYS_CHALLENGE_TTL=300
# APP_PASSKEYS_LOGIN_MAX_ATTEMPTS=5

# Mail — log (default) | memory (tests) | smtp (requires `pip install 'fastplace[mail]'`)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=fastplace@localhost
# Display name for the outbound sender — "Name <address>" (empty = bare address)
MAIL_FROM_NAME=
# SMTP settings (MAIL_DRIVER=smtp) — MAIL_ENCRYPTION: none | tls | starttls
# MAIL_HOST=127.0.0.1
# MAIL_PORT=25
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=none

# Database (default: zero-config SQLite)
# DATABASE_DRIVER=sqlite
# DATABASE_URL=sqlite+aiosqlite:///./database.sqlite3
# Pool tuning (server backends only — sqlite uses one serialized connection)
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_ECHO=false
# Read replicas (JSON array or comma-separated) — standalone reads round-robin
# across them; any write pins the rest of the request to the primary
# (read-after-write consistency).
# DATABASE_READ_REPLICAS=["postgresql://host/replica1", "postgresql://host/replica2"]
# MySQL/MariaDB charset pinning — tables and connections default to utf8mb4
# whatever the server's default charset is; override only with care.
# DATABASE_CHARSET=utf8mb4
# DATABASE_COLLATION=utf8mb4_unicode_ci

# Query instrumentation (every engine)
# Statements slower than QUERY_SLOW_MS warn; a statement repeating
# QUERY_N1_THRESHOLD times in one request flags the N+1 pattern.
# QUERY_SLOW_MS=250
# QUERY_N1_THRESHOLD=5

# MongoDB (document adapter — fastplace.orm.documents.Document)
# MONGODB_URL=mongodb://localhost:27017/appdb
# MONGODB_DATABASE=appdb  # only needed when the URL names no database

# Cache — memory (dev default) | redis | database
CACHE_DRIVER=memory
CACHE_TTL=3600
# Redis keys are namespaced (the DB is shared with the queue) — flush() clears only this prefix
CACHE_PREFIX=fastplace:cache:
REDIS_URL=redis://localhost:6379/0

# Queue — memory (default dev driver) or saq (production, redis-backed)
QUEUE_DRIVER=memory
QUEUE_NAME=fastplace
QUEUE_REDIS_URL=redis://localhost:6379/0
# Retry knobs (saq jobs): total attempts, per-attempt execution timeout (s),
# exponential backoff base (s, 0 = off), result retention TTL (s).
# QUEUE_TRIES=3
# QUEUE_TIMEOUT=60
# QUEUE_BACKOFF=0
# QUEUE_TTL=600

# SAQ web dashboard (OFF by default; mounts only under QUEUE_DRIVER=saq).
# ABILITY empty = any authenticated user; a set value must be an ability
# your gates define (queue:health and first request both fail loud otherwise).
#QUEUE_DASHBOARD_ENABLED=false
#QUEUE_DASHBOARD_PATH=/queue-dashboard
#QUEUE_DASHBOARD_ABILITY=

# S3 storage disk (uncomment the "s3" entry in config/storage.py and
# pip install 'fastplace[s3]'). Values feed the per-key config() calls —
# the STORAGE_DISKS dict itself does not ride through the environment.
# S3_BUCKET=app-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=            # MinIO/R2-style endpoint, empty for AWS
# S3_PREFIX=                  # key prefix, e.g. "tenants/7"
# S3_PUBLIC_BASE=             # CDN/app base for stable public URLs
# S3_PUBLIC=false             # 1/true/yes/on enable public URLs; anything else disables

# Broadcasting — /ws/broadcast channel fan-out. memory (default,
# single-process) or redis (cross-process; reuses the queue's redis when
# BROADCAST_REDIS_URL is empty). Private/presence channels need
# BROADCAST_PRIVATE_ABILITY (a gate your app defines) — unset denies
# everyone, fail-closed by design.
#BROADCAST_ENABLED=true
#BROADCAST_DRIVER=memory
#BROADCAST_REDIS_URL=            # empty = QUEUE_REDIS_URL
#BROADCAST_CHANNEL_PREFIX=fastplace:broadcast:
#BROADCAST_PRIVATE_ABILITY=
#BROADCAST_MAX_PAYLOAD_BYTES=65536
# Per-socket limits: channel cap, outbound queue bound, ping interval (s).
#BROADCAST_MAX_SUBSCRIPTIONS=100
#BROADCAST_SOCKET_QUEUE_SIZE=256
#BROADCAST_PING_INTERVAL=30

# AI — LiteLLM model strings; API keys come from the environment
# (OPENAI_API_KEY / ANTHROPIC_API_KEY), never from this file.
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_ROUNDS=8
AI_VECTOR_STORE=pgvector

# Logging — channels write to storage/logs/ (booted by `fastplace serve` /
# create_app). single = rotating file | daily = midnight-rotated file |
# stderr | null | stack = every channel in LOG_STACK.
LOG_CHANNEL=single
LOG_LEVEL=INFO
# Used when LOG_CHANNEL=stack (comma-separated: single, daily, stderr, null)
LOG_STACK=single,daily,stderr
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_DAILY_DAYS=7

# MCP — fastplace-aibrain server (`fastplace mcp start` / `fastplace mcp
# install`). Enabled by default; the server only talks over stdio.
#FASTPLACE_MCP_ENABLED=true
# Hosted docs digest API the search-docs tool queries (served by the
# deployed fastplace.dev site itself — no docs subdomain exists).
#FASTPLACE_MCP_API_URL=https://fastplace.dev
# Per-tool HTTP timeout in seconds (search-docs and friends).
#FASTPLACE_MCP_TOOL_TIMEOUT=180
# tinker executes Python against the app in an isolated subprocess — opt-in.
#FASTPLACE_MCP_TINKER=false
# record-rule writes project rules into .fastplace/rules/.
#FASTPLACE_MCP_RULES=true
# browser-logs reads the dev-only console capture feed (needs debug on).
#FASTPLACE_MCP_BROWSER_LOGS=true
# Comma-separated tool names to unregister (e.g. database-query,tinker).
#FASTPLACE_MCP_TOOLS_EXCLUDE=
